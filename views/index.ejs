<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
<h1>Student Detail</h1>

<table border="1" cellpadding ='5'>
    <tr>
        <th>Name</th>
        <th>City</th>
        <th>Age</th>
    </tr>

    <% student.forEach((stu) => { %>
        <tr>
            <td><%= stu.name %></td>
            <td><%= stu.city %></td>
            <td><%= stu.age %></td>
        </tr>
    <% }) %>
</table>

    
</body>
</html>