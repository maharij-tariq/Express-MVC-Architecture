<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
<body>
    <h2>Users Details</h2>

    <% if (index) { %>
        <p>Name: <%= index.name %></p>
        <p>Role: <%= index.role %></p>
        <p>Role: <%= index.age %></p>

        <% if (index.role === 'Admin') { %>
            <p><strong>The user has full access.</strong></p>

        <% } else if (index.role === 'Editor') { %>
            <p><strong>The user has editor access only.</strong></p>

        <% } else { %>
            <p><strong>The user has limited access.</strong></p>
        <% } %>

    <% } else { %>
        <p>User not found.</p>
    <% } %>

</body>
</html>

    
</body>
</html>